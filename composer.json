{
  "name": "lockally/laravel",
  "description": "Official Lockally mail driver for Laravel — send transactional email via Lockally with Mail::mailer('lockally').",
  "keywords": ["lockally", "laravel", "mail", "mailer", "email", "transactional"],
  "homepage": "https://github.com/lockallyinc/lockally-laravel",
  "license": "MIT",
  "authors": [{ "name": "Lockally", "email": "support@lockally.com", "homepage": "https://lockally.com" }],
  "require": {
    "php": "^8.1",
    "lockally/sdk": "^0.1",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "symfony/mailer": "^6.2 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": { "Lockally\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Lockally\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Lockally\\Laravel\\LockallyServiceProvider"]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": { "sort-packages": true }
}
